# Supabase project (Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Secret key. Server only: seed script and admin invites. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Web3Forms access key (public by design), recipient ipbrobotic@apps.ipb.ac.id
NEXT_PUBLIC_WEB3FORMS_KEY=
# Canonical site URL, used for metadata, sitemap and invite links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Seed only: email that receives the first admin invitation
SEED_ADMIN_EMAIL=
